<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Controle Financeiro</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #f3f6fa;
      color: #222;
    }

    header {
      background: #0066b3;
      color: white;
      padding: 15px;
      text-align: center;
    }

    header h2 {
      margin: 0;
    }

    .wrap {
      max-width: 1100px;
      margin: auto;
      padding: 12px;
    }

    .card {
      background: white;
      padding: 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.10);
    }

    label {
      display: block;
      font-weight: bold;
      margin-top: 6px;
      margin-bottom: 4px;
    }

    input,
    select,
    button {
      width: 100%;
      padding: 12px;
      margin: 4px 0;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: #0066b3;
    }

    button {
      background: #0066b3;
      color: white;
      border: none;
      cursor: pointer;
      font-weight: bold;
    }

    button:hover {
      opacity: 0.90;
    }

    .btn-desfazer {
      background: #777;
    }

    .btn-delete {
      width: auto;
      min-width: 45px;
      background: #dc2626;
      padding: 8px 10px;
      margin: 0;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 15px;
    }

    @media (min-width: 900px) {

      .grid {
        grid-template-columns: 1fr 1fr;
      }

    }

    .filtros {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 7px;
    }

    th {
      background: #e74c3c;
      color: white;
      text-align: left;
    }

    .green th {
      background: #16a34a;
    }

    .resumo {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .resumo-item {
      padding: 12px;
      border-radius: 8px;
      background: #f5f5f5;
    }

    .resumo-item strong {
      display: block;
      margin-bottom: 6px;
    }

    .resumo-saldo {
      background: #e8f5e9;
    }

    .despesa-input {
      width: 100%;
      padding: 7px;
      margin: 0;
      font-size: 14px;
    }

    .vazio {
      text-align: center;
      color: #777;
      padding: 15px;
    }

    .toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: #16a34a;
      color: white;
      padding: 11px 18px;
      border-radius: 8px;
      z-index: 9999;
      box-shadow: 0 3px 12px rgba(0,0,0,0.25);
    }

    .data-coluna {
      white-space: nowrap;
    }

    @media (max-width: 600px) {

      .resumo {
        grid-template-columns: 1fr;
      }

      .filtros {
        grid-template-columns: 1fr 1fr;
      }

      table {
        font-size: 12px;
      }

      th,
      td {
        padding: 5px;
      }

    }

  </style>

</head>


<body>

<header>

  <h2>Planilha Financeira</h2>

</header>


<div class="wrap">


  <!-- =========================
       SELEÇÃO DO PERÍODO
  ========================== -->

  <div class="card">

    <div class="filtros">

      <div>

        <label for="mes">
          Mês
        </label>

        <select id="mes">

          <option value="1">Janeiro</option>
          <option value="2">Fevereiro</option>
          <option value="3">Março</option>
          <option value="4">Abril</option>
          <option value="5">Maio</option>
          <option value="6">Junho</option>
          <option value="7">Julho</option>
          <option value="8">Agosto</option>
          <option value="9">Setembro</option>
          <option value="10">Outubro</option>
          <option value="11">Novembro</option>
          <option value="12">Dezembro</option>

        </select>

      </div>


      <div>

        <label for="ano">
          Ano
        </label>

        <select id="ano"></select>

      </div>

    </div>

  </div>


  <!-- =========================
       ENTRADAS
  ========================== -->

  <div class="card">

    <label for="entrada">

      Total de Entradas

    </label>

    <input
      id="entrada"
      type="number"
      step="0.01"
      min="0"
      placeholder="Digite o valor total"
    >

    <button id="btnSalvarEntrada">

      Salvar Entradas

    </button>

  </div>


  <!-- =========================
       RESUMO
  ========================== -->

  <div class="card">

    <div class="resumo">

      <div class="resumo-item">

        <strong>
          Entradas
        </strong>

        <span id="totalEntradas">
          R$ 0,00
        </span>

      </div>


      <div class="resumo-item">

        <strong>
          Saídas
        </strong>

        <span id="saidas">
          R$ 0,00
        </span>

      </div>


      <div class="resumo-item resumo-saldo">

        <strong>
          Saldo
        </strong>

        <span id="saldo">
          R$ 0,00
        </span>

      </div>

    </div>

  </div>


  <!-- =========================
       NOVO LANÇAMENTO
  ========================== -->

  <div class="card">

    <h3>
      Novo Lançamento
    </h3>


    <label for="data">

      Data do lançamento

    </label>

    <input
      id="data"
      type="date"
    >


    <label for="tipo">

      Tipo

    </label>

    <select id="tipo">

      <option value="Receita">
        Receita
      </option>

      <option value="Despesa">
        Despesa
      </option>

    </select>


    <label for="descricao">

      Descrição

    </label>

    <input
      id="descricao"
      type="text"
      placeholder="Descrição"
    >


    <label for="valor">

      Valor

    </label>

    <input
      id="valor"
      type="number"
      step="0.01"
      min="0"
      placeholder="Valor"
    >


    <label for="parcela">

      Categoria / Parcela

    </label>

    <select id="parcela">

      <option value="FIXO">
        FIXO
      </option>

      <option value="VARIÁVEL">
        VARIÁVEL
      </option>

      <option value="1x">
        1x
      </option>

      <option value="2x">
        2x
      </option>

      <option value="3x">
        3x
      </option>

      <option value="6x">
        6x
      </option>

      <option value="8x">
        8x
      </option>

      <option value="10x">
        10x
      </option>

    </select>


    <button id="btnAdicionar">

      Adicionar

    </button>


    <button
      id="btnDesfazer"
      class="btn-desfazer"
    >

      Desfazer

    </button>

  </div>


  <!-- =========================
       TABELAS
  ========================== -->

  <div class="grid">


    <!-- RECEITAS -->

    <div class="card">

      <table class="green">

        <thead>

          <tr>

            <th>
              Data
            </th>

            <th>
              Receita
            </th>

            <th>
              Valor
            </th>

            <th>
              Ação
            </th>

          </tr>

        </thead>

        <tbody id="trec"></tbody>

      </table>

    </div>


    <!-- DESPESAS -->

    <div class="card">

      <table>

        <thead>

          <tr>

            <th>
              Data
            </th>

            <th>
              Despesa
            </th>

            <th>
              Valor
            </th>

            <th>
              Ação
            </th>

          </tr>

        </thead>

        <tbody id="tdes"></tbody>

      </table>

    </div>

  </div>


  <div id="msg"></div>


</div>


<script>

document.addEventListener(
  "DOMContentLoaded",
  function () {


    /* =========================
       ELEMENTOS
    ========================== */

    const mes =
      document.getElementById("mes");

    const ano =
      document.getElementById("ano");

    const entrada =
      document.getElementById("entrada");

    const data =
      document.getElementById("data");

    const tipo =
      document.getElementById("tipo");

    const descricao =
      document.getElementById("descricao");

    const valor =
      document.getElementById("valor");

    const parcela =
      document.getElementById("parcela");

    const trec =
      document.getElementById("trec");

    const tdes =
      document.getElementById("tdes");

    const totalEntradas =
      document.getElementById("totalEntradas");

    const saidas =
      document.getElementById("saidas");

    const saldo =
      document.getElementById("saldo");

    const msg =
      document.getElementById("msg");

    const btnSalvarEntrada =
      document.getElementById(
        "btnSalvarEntrada"
      );

    const btnAdicionar =
      document.getElementById(
        "btnAdicionar"
      );

    const btnDesfazer =
      document.getElementById(
        "btnDesfazer"
      );


    /* =========================
       MESES
    ========================== */

    const nomesMeses = [

      "Janeiro",
      "Fevereiro",
      "Março",
      "Abril",
      "Maio",
      "Junho",
      "Julho",
      "Agosto",
      "Setembro",
      "Outubro",
      "Novembro",
      "Dezembro"

    ];


    /* =========================
       ANOS
    ========================== */

    const anoAtual =
      new Date().getFullYear();


    for (
      let i = 2020;
      i <= 2035;
      i++
    ) {

      const option =
        document.createElement("option");

      option.value = i;

      option.textContent = i;

      ano.appendChild(option);

    }


    /* =========================
       BANCO DE DADOS
    ========================== */

    let db = {};


    try {

      db =
        JSON.parse(
          localStorage.getItem(
            "dbfin"
          )
        ) || {};

    } catch (erro) {

      db = {};

    }


    /* =========================
       GARANTIR ESTRUTURA
    ========================== */

    function garantirPeriodo(
      chave
    ) {

      if (!db[chave]) {

        db[chave] = {

          entrada: 0,

          receitas: [],

          despesas: []

        };

      }


      if (
        !Array.isArray(
          db[chave].receitas
        )
      ) {

        db[chave].receitas = [];

      }


      if (
        !Array.isArray(
          db[chave].despesas
        )
      ) {

        db[chave].despesas = [];

      }


      return db[chave];

    }


    /* =========================
       CHAVE DO PERÍODO
    ========================== */

    function chavePeriodo() {

      return (
        mes.value +
        "-" +
        ano.value
      );

    }


    /* =========================
       PERÍODO ATUAL
    ========================== */

    garantirPeriodo(
      chavePeriodo()
    );


    /* =========================
       SELECIONAR MÊS ATUAL
    ========================== */

    mes.value =
      String(
        new Date().getMonth() + 1
      );

    ano.value =
      String(anoAtual);


    garantirPeriodo(
      chavePeriodo()
    );


    /* =========================
       SALVAR BANCO
    ========================== */

    function salvarBanco() {

      localStorage.setItem(
        "dbfin",
        JSON.stringify(db)
      );

    }


    /* =========================
       CURRENCY
    ========================== */

    function br(valor) {

      return Number(
        valor || 0
      ).toLocaleString(
        "pt-BR",
        {
          style: "currency",
          currency: "BRL"
        }
      );

    }


    /* =========================
       DATA BRASILEIRA
    ========================== */

    function formatarData(
      dataISO
    ) {

      if (!dataISO) {

        return "-";

      }


      const partes =
        dataISO.split("-");


      if (
        partes.length !== 3
      ) {

        return dataISO;

      }


      return (
        partes[2] +
        "/" +
        partes[1] +
        "/" +
        partes[0]
      );

    }


    /* =========================
       ESCAPE HTML
    ========================== */

    function escapeHTML(
      texto
    ) {

      return String(
        texto || ""
      )
        .replace(
          /&/g,
          "&amp;"
        )
        .replace(
          /</g,
          "&lt;"
        )
        .replace(
          />/g,
          "&gt;"
        )
        .replace(
          /"/g,
          "&quot;"
        )
        .replace(
          /'/g,
          "&#039;"
        );

    }


    /* =========================
       TOAST
    ========================== */

    function toast(
      texto
    ) {

      msg.innerHTML =
        '<div class="toast">' +
        escapeHTML(texto) +
        "</div>";


      setTimeout(
        function () {

          msg.innerHTML = "";

        },
        2000
      );

    }


    /* =========================
       DATA DE HOJE
    ========================== */

    function dataHoje() {

      const agora =
        new Date();


      const anoHoje =
        agora.getFullYear();


      const mesHoje =
        String(
          agora.getMonth() + 1
        ).padStart(2, "0");


      const diaHoje =
        String(
          agora.getDate()
        ).padStart(2, "0");


      return (
        anoHoje +
        "-" +
        mesHoje +
        "-" +
        diaHoje
      );

    }


    data.value =
      dataHoje();


    /* =========================
       PERÍODO SELECIONADO
    ========================== */

    function atual() {

      const chave =
        chavePeriodo();


      return garantirPeriodo(
        chave
      );

    }


    /* =========================
       SALVAR ENTRADA
    ========================== */

    function salvarEntrada() {

      atual().entrada =
        Number(
          entrada.value || 0
        );


      salvarBanco();

      render();

      toast(
        "Entradas salvas!"
      );

    }


    /* =========================
       ADICIONAR LANÇAMENTO
    ========================== */

    function adicionar() {

      const descricaoTexto =
        descricao.value.trim();


      const valorNumero =
        Number(
          valor.value || 0
        );


      if (!data.value) {

        toast(
          "Informe a data."
        );

        data.focus();

        return;

      }


      if (!descricaoTexto) {

        toast(
          "Digite uma descrição."
        );

        descricao.focus();

        return;

      }


      if (
        valorNumero <= 0
      ) {

        toast(
          "Digite um valor válido."
        );

        valor.focus();

        return;

      }


      /*
       * Verifica se a data pertence
       * ao mês/ano selecionado.
       */

      const dataInformada =
        new Date(
          data.value + "T00:00:00"
        );


      const mesData =
        dataInformada.getMonth() + 1;


      const anoData =
        dataInformada.getFullYear();


      if (
        mesData !==
          Number(mes.value) ||
        anoData !==
          Number(ano.value)
      ) {

        const confirmar =
          confirm(
            "A data informada pertence a " +
            nomesMeses[mesData - 1] +
            "/" +
            anoData +
            ", mas o período selecionado é " +
            nomesMeses[
              Number(mes.value) - 1
            ] +
            "/" +
            ano.value +
            ".\n\n" +
            "Deseja lançar mesmo assim neste período?"
          );


        if (!confirmar) {

          return;

        }

      }


      const lancamento = {

        id:
          Date.now() +
          Math.random(),

        data:
          data.value,

        descricao:
          descricaoTexto,

        valor:
          valorNumero,

        parcela:
          parcela.value

      };


      if (
        tipo.value ===
        "Receita"
      ) {

        atual()
          .receitas
          .push(
            lancamento
          );

      } else {

        atual()
          .despesas
          .push(
            lancamento
          );

      }


      salvarBanco();

      render();

      descricao.value = "";

      valor.value = "";

      descricao.focus();

      toast(
        "Lançamento salvo!"
      );

    }


    /* =========================
       ÚLTIMA AÇÃO
    ========================== */

    let last = null;


    /* =========================
       EXCLUIR RECEITA
    ========================== */

    function excluirReceita(
      indice
    ) {

      const lista =
        atual().receitas;


      if (
        !lista[indice]
      ) {

        return;

      }


      if (
        !confirm(
          "Deseja excluir esta receita?"
        )
      ) {

        return;

      }


      last = {

        tipo: "receita",

        acao: "excluir",

        indice: indice,

        objeto:
          {
            ...lista[indice]
          }

      };


      lista.splice(
        indice,
        1
      );


      salvarBanco();

      render();

      toast(
        "Receita excluída!"
      );

    }


    /* =========================
       EXCLUIR DESPESA
    ========================== */

    function excluirDespesa(
      indice
    ) {

      const lista =
        atual().despesas;


      if (
        !lista[indice]
      ) {

        return;

      }


      if (
        !confirm(
          "Deseja excluir esta despesa?"
        )
      ) {

        return;

      }


      last = {

        tipo: "despesa",

        acao: "excluir",

        indice: indice,

        objeto:
          {
            ...lista[indice]
          }

      };


      lista.splice(
        indice,
        1
      );


      salvarBanco();

      render();

      toast(
        "Despesa excluída!"
      );

    }


    /* =========================
       EDITAR DESPESA
    ========================== */

    function editarDespesa(
      indice,
      novoValor
    ) {

      const lista =
        atual().despesas;


      if (
        !lista[indice]
      ) {

        return;

      }


      const valorAnterior =
        lista[indice].valor;


      const novo =
        Number(
          novoValor || 0
        );


      if (
        novo < 0
      ) {

        return;

      }


      last = {

        tipo: "despesa",

        acao: "editar",

        indice: indice,

        objeto:
          {
            ...lista[indice]
          }

      };


      lista[indice].valor =
        novo;


      salvarBanco();

      render();

    }


    /* =========================
       DESFAZER
    ========================== */

    function desfazer() {

      if (!last) {

        toast(
          "Nada para desfazer."
        );

        return;

      }


      const periodo =
        atual();


      if (
        last.acao ===
        "excluir"
      ) {

        if (
          last.tipo ===
          "receita"
        ) {

          periodo.receitas.splice(
            last.indice,
            0,
            last.objeto
          );

        } else {

          periodo.despesas.splice(
            last.indice,
            0,
            last.objeto
          );

        }

      }


      if (
        last.acao ===
        "editar"
      ) {

        periodo.despesas[
          last.indice
        ] =
          last.objeto;

      }


      salvarBanco();

      render();

      toast(
        "Ação desfeita!"
      );


      last = null;

    }


    /* =========================
       RENDERIZAR
    ========================== */

    function render() {

      const periodo =
        atual();


      /*
       * Entrada
       */

      entrada.value =
        periodo.entrada ||
        "";


      totalEntradas.innerT